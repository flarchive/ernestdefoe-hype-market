{
    "name": "ernestdefoe/hype-market",
    "description": "Hype Market: members back the new discussions they think will take off. Free daily hype, prices that follow real engagement, race-safe settlement, portfolios with sparklines, a hottest list and monthly season leaderboards. No real money.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "engagement",
        "game",
        "leaderboard",
        "market",
        "gamification"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/hype-market",
    "support": {
        "issues": "https://github.com/ernestdefoe/hype-market/issues",
        "source": "https://github.com/ernestdefoe/hype-market"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\HypeMarket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\HypeMarket\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Hype Market",
            "category": "feature",
            "icon": {
                "name": "fas fa-fire",
                "backgroundColor": "#ea580c",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/likes",
                "flarum/approval",
                "flarum/gdpr"
            ]
        }
    },
    "require-dev": {
        "flarum/gdpr": "^2.0",
        "flarum/likes": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
